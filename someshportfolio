<style>
  :root{
    --navy:#0f172a;
    --navy-soft:#1e293b;
    --ink:#334155;
    --muted:#64748b;
    --line:#e2e8f0;
    --wash:#f1f5f9;
    --white:#ffffff;
    --accent:#3b82f6;
    --accent-dark:#1d4ed8;
    --radius:12px;
    --max:1100px;
  }

  *,*::before,*::after{box-sizing:border-box;}
  html{scroll-behavior:smooth;scroll-padding-top:84px;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation:none !important;transition:none !important;}
  }

  body{
    margin:0;
    font-family:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:17px;
    line-height:1.7;
    color:var(--ink);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }

  .wrap{width:100%;max-width:var(--max);margin:0 auto;padding:0 22px;}

  h1,h2,h3{color:var(--navy);line-height:1.2;margin:0;letter-spacing:-0.02em;}
  p{margin:0 0 1.1em;}
  a{color:var(--accent-dark);}
  ul{margin:0;padding:0;list-style:none;}

  :focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px;}

  /* ---------- navigation ---------- */
  .nav{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,0.92);
    backdrop-filter:saturate(180%) blur(12px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:66px;}
  .brand{font-weight:700;color:var(--navy);text-decoration:none;font-size:1.05rem;letter-spacing:-0.02em;}
  .brand span{color:var(--accent);}
  .nav-links{display:none;gap:28px;align-items:center;}
  .nav-links a{color:var(--muted);text-decoration:none;font-size:0.94rem;font-weight:500;transition:color .18s ease;}
  .nav-links a:hover{color:var(--navy);}
  .menu-btn{
    display:inline-flex;flex-direction:column;justify-content:center;gap:5px;
    width:42px;height:42px;padding:10px;border:1px solid var(--line);
    background:var(--white);border-radius:10px;cursor:pointer;
  }
  .menu-btn span{display:block;height:2px;background:var(--navy);border-radius:2px;}
  .mobile-menu{display:none;border-top:1px solid var(--line);padding:10px 0 18px;}
  .mobile-menu.open{display:block;}
  .mobile-menu a{
    display:block;padding:11px 22px;color:var(--navy);
    text-decoration:none;font-weight:500;
  }
  @media(min-width:860px){
    .nav-links{display:flex;}
    .menu-btn{display:none;}
    .mobile-menu{display:none !important;}
  }

  /* ---------- hero ---------- */
  .hero{
    background:
      radial-gradient(900px 420px at 88% 8%, rgba(59,130,246,0.22), transparent 60%),
      linear-gradient(180deg,var(--navy) 0%, #12203c 100%);
    color:#cbd5e1;
    padding:72px 0 78px;
  }
  .hero-grid{display:grid;gap:34px;align-items:center;}
  .badge{
    display:inline-flex;align-items:center;gap:8px;
    font-size:0.82rem;font-weight:500;color:#bfdbfe;
    background:rgba(59,130,246,0.14);
    border:1px solid rgba(59,130,246,0.38);
    border-radius:999px;padding:6px 14px;margin-bottom:22px;
  }
  .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;}
  .hero h1{
    color:var(--white);
    font-size:clamp(2.4rem,7vw,3.9rem);
    font-weight:800;
    margin-bottom:16px;
  }
  .hero .headline{
    font-size:clamp(1.05rem,2.6vw,1.35rem);
    color:#e2e8f0;font-weight:500;max-width:34ch;margin-bottom:14px;
  }
  .hero .blurb{color:#94a3b8;max-width:52ch;font-size:1rem;}
  .cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px;}
  .btn{
    display:inline-block;padding:13px 26px;border-radius:10px;
    font-weight:600;font-size:0.97rem;text-decoration:none;
    transition:transform .18s ease, background .18s ease, box-shadow .18s ease;
  }
  .btn-primary{background:var(--accent);color:var(--white);box-shadow:0 8px 20px rgba(59,130,246,0.32);}
  .btn-primary:hover{background:var(--accent-dark);transform:translateY(-2px);}
  .btn-ghost{border:1px solid rgba(203,213,225,0.45);color:#e2e8f0;}
  .btn-ghost:hover{background:rgba(255,255,255,0.08);transform:translateY(-2px);}

  /* REPLACE: PHOTO — circular portrait frame */
  .portrait{display:none;}
  .portrait-ring{
    width:260px;height:260px;border-radius:50%;
    background:linear-gradient(140deg,rgba(59,130,246,0.85),rgba(15,23,42,0.2));
    padding:5px;margin-left:auto;
    box-shadow:0 24px 60px rgba(2,6,23,0.55);
  }
  .portrait-inner{
    width:100%;height:100%;border-radius:50%;
    background:#16233f;display:flex;align-items:center;justify-content:center;
    color:#7dabf8;font-size:3.6rem;font-weight:700;letter-spacing:0.02em;
    overflow:hidden;
  }
  .portrait-inner img{width:100%;height:100%;object-fit:cover;border-radius:50%;}
  @media(min-width:860px){
    .hero-grid{grid-template-columns:1.35fr 0.65fr;}
    .portrait{display:block;}
  }

  /* ---------- sections ---------- */
  section{padding:76px 0;}
  .alt{background:var(--wash);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .sec-head{max-width:62ch;margin-bottom:38px;}
  .sec-head h2{font-size:clamp(1.65rem,4vw,2.2rem);font-weight:700;margin-bottom:12px;}
  .sec-head .rule{width:52px;height:4px;background:var(--accent);border-radius:4px;margin-bottom:18px;}
  .sec-head p{color:var(--muted);margin:0;}
  .prose{max-width:66ch;}
  .prose p{color:var(--ink);}

  /* ---------- experience timeline ---------- */
  .timeline{position:relative;padding-left:26px;}
  .timeline::before{
    content:"";position:absolute;left:6px;top:8px;bottom:8px;
    width:2px;background:var(--line);
  }
  .role{position:relative;margin-bottom:22px;}
  .role::before{
    content:"";position:absolute;left:-26px;top:26px;
    width:13px;height:13px;border-radius:50%;
    background:var(--white);border:3px solid var(--accent);
  }
  .role-card{
    background:var(--white);border:1px solid var(--line);
    border-radius:var(--radius);padding:24px;
    box-shadow:0 1px 3px rgba(15,23,42,0.05);
  }
  .role-card h3{font-size:1.15rem;font-weight:700;}
  .company{color:var(--accent-dark);font-weight:600;font-size:0.98rem;margin-top:3px;}
  .meta{color:var(--muted);font-size:0.88rem;margin-top:5px;}
  .role-card ul{margin-top:14px;}
  .role-card li{position:relative;padding-left:20px;margin-bottom:8px;font-size:0.96rem;}
  .role-card li::before{
    content:"";position:absolute;left:4px;top:11px;
    width:6px;height:6px;border-radius:50%;background:#cbd5e1;
  }
  .stint{
    border-left:2px solid var(--line);
    margin:14px 0 0 2px;padding:4px 0 0 16px;
  }
  .stint h4{margin:0;font-size:1rem;color:var(--navy);font-weight:600;}

  /* ---------- skills ---------- */
  .skill-groups{display:grid;gap:26px;}
  @media(min-width:760px){.skill-groups{grid-template-columns:repeat(3,1fr);}}
  .skill-group h3{font-size:1rem;font-weight:700;margin-bottom:14px;}
  .pills{display:flex;flex-wrap:wrap;gap:9px;}
  .pill{
    background:var(--white);border:1px solid var(--line);
    color:var(--navy);border-radius:999px;
    padding:7px 15px;font-size:0.88rem;font-weight:500;
  }
  .pill.solid{background:var(--navy);border-color:var(--navy);color:var(--white);}

  /* ---------- cards grid ---------- */
  .grid{display:grid;gap:18px;}
  @media(min-width:760px){.grid-2{grid-template-columns:1fr 1fr;}}
  .card{
    background:var(--white);border:1px solid var(--line);
    border-radius:var(--radius);padding:24px;
    box-shadow:0 1px 3px rgba(15,23,42,0.05);
  }
  .card h3{font-size:1.08rem;font-weight:700;}
  .card .meta{margin-top:6px;}
  .cert-list li{
    display:flex;gap:14px;align-items:flex-start;
    padding:15px 0;border-bottom:1px solid var(--line);
    font-size:0.97rem;color:var(--navy);
  }
  .cert-list li:last-child{border-bottom:0;}
  .cert-mark{
    flex:none;width:9px;height:9px;margin-top:9px;
    border-radius:3px;background:var(--accent);
  }

  /* ---------- contact ---------- */
  .contact-grid{display:grid;gap:26px;}
  @media(min-width:860px){.contact-grid{grid-template-columns:0.9fr 1.1fr;}}
  .contact-line{
    display:flex;gap:14px;align-items:center;
    padding:14px 0;border-bottom:1px solid var(--line);
  }
  .contact-line:last-of-type{border-bottom:0;}
  .contact-line .label{font-size:0.8rem;color:var(--muted);}
  .contact-line a,.contact-line span.val{color:var(--navy);text-decoration:none;font-weight:600;word-break:break-word;}
  .contact-line a:hover{color:var(--accent-dark);}
  .icon{
    flex:none;width:38px;height:38px;border-radius:10px;
    background:var(--wash);display:flex;align-items:center;justify-content:center;
  }
  .icon svg{width:18px;height:18px;fill:var(--navy);}
  /* ---------- footer ---------- */
  footer{background:var(--navy);color:#94a3b8;padding:36px 0;font-size:0.9rem;}
  .foot-inner{display:flex;flex-direction:column;gap:16px;align-items:center;text-align:center;}
  .foot-social{display:flex;gap:12px;}
  .foot-social a{
    width:38px;height:38px;border-radius:10px;
    background:rgba(255,255,255,0.07);
    display:flex;align-items:center;justify-content:center;
    transition:background .18s ease;
  }
  .foot-social a:hover{background:rgba(59,130,246,0.35);}
  .foot-social svg{width:17px;height:17px;fill:#e2e8f0;}
  @media(min-width:760px){
    .foot-inner{flex-direction:row;justify-content:space-between;text-align:left;}
  }

  /* ---------- print ---------- */
  @media print{
    .nav,.mobile-menu,.cta-row,.portrait,.contact-form,footer .foot-social{display:none !important;}
    body{font-size:11pt;color:#000;}
    .hero{background:#fff !important;color:#000;padding:0 0 18pt;}
    .hero h1,.hero .headline,.hero .blurb{color:#000 !important;}
    .badge{border-color:#999;color:#000;background:none;}
    section{padding:14pt 0;page-break-inside:avoid;}
    .alt{background:#fff;}
    .role-card,.card{box-shadow:none;border:1px solid #ccc;}
    footer{background:#fff;color:#000;}
  }
</style>
</head>
